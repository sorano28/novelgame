        }
      ],
      "defaultNext": "chapter12_final_choice"
    },
    "chapter12_final_choice": {
      "id": "chapter12_final_choice",
      "type": "endingChoice",
      "question": "最後に、なにを選ぶ？",
      "options": [
        { "text": "恋人を殺す", "select": "kill" },
        { "text": "恋人と共に滅びる", "select": "together" },
        { "text": "世界を選ぶ", "select": "world" },
        { "text": "救おうとする", "select": "save" }
      ]
    },
    "chapter12_final_choice_hidden": {
      "id": "chapter12_final_choice_hidden",
      "type": "endingChoice",
      "question": "最後に、なにを選ぶ？（隠し選択が解放された）",
      "options": [
        { "text": "恋人を殺す", "select": "kill" },
        { "text": "恋人と共に滅びる", "select": "together" },
        { "text": "世界を選ぶ", "select": "world" },
        { "text": "救おうとする", "select": "save" },
        { "text": "自分を裁く", "select": "suicide", "requires": "flags.memory >= 5 && flags.blameSelf >= 2" }
      ]
    },
    "end1_kill": {
      "id": "end1_kill",
      "type": "ending",
      "title": "END 1 / 殺す",
      "text": "刃は震え、世界は静かに延命した。{name}は誰よりも深い傷だけを抱えて歩き出す。"
    },
    "end2_together": {
      "id": "end2_together",
      "type": "ending",
      "title": "END 2 / 共に滅びる",
      "text": "世界の最期に、ふたりは寄り添った。崩れゆく光の中で、きみの名だけが残る。"
    },
    "end3_world": {
      "id": "end3_world",
      "type": "ending",
      "title": "END 3 / 世界を選ぶ",
      "text": "きみを失っても、{name}は世界へ手を伸ばした。朝焼けの先で、誰かの明日が息を吹き返す。"
    },
    "end4_fail": {
      "id": "end4_fail",
      "type": "ending",
      "title": "END 4 / 救えない",
      "text": "手は届きそうで届かなかった。赦しきれない過去が、ふたりを別々の闇に沈める。"
    },
    "end5_suicide": {
      "id": "end5_suicide",
      "type": "ending",
      "title": "END 5 / 自殺",
      "text": "すべてを思い出した{name}は、自分に最後の判決を下した。静かな海だけが、その名を知っていた。"
    }
  }
